{
    "name": "@hiero-hackers/enterprise-express",
    "version": "0.2.0",
    "description": "Express middleware for the Hiero network",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "repository": "https://github.com/hiero-hackers/hiero-enterprise-js",
    "bugs": "https://github.com/hiero-hackers/hiero-enterprise-js/issues",
    "keywords": [
        "hiero",
        "hedera",
        "express",
        "transactions",
        "hiero-enterprise"
    ],
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist",
        "test": "pnpm run test:integration",
        "test:unit": "vitest run test/integration",
        "test:integration": "vitest run test/integration",
        "test:watch": "vitest test/integration"
    },
    "dependencies": {
        "@hiero-hackers/enterprise-core": "workspace:*",
        "@hiero-hackers/enterprise-mirror": "workspace:*"
    },
    "peerDependencies": {
        "express": "^5.1.0"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
