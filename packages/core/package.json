{
    "name": "@hiero-hackers/enterprise-core",
    "version": "0.1.0",
    "description": "Core services, repositories, and data models for the Hiero network",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "repository": "https://github.com/hiero-hackers/hiero-enterprise-js",
    "bugs": "https://github.com/hiero-hackers/hiero-enterprise-js/issues",
    "keywords": [
        "core",
        "hiero",
        "hedera",
        "transactions",
        "hiero-enterprise"
    ],
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "pnpm run build:test && tsup",
        "build:test": "tsc --noEmit -p test/tsconfig.test.json",
        "clean": "rm -rf dist",
        "test:unit": "vitest run -c test/vitest.config.ts",
        "test:unit:coverage": "vitest run -c test/vitest.config.ts --coverage",
        "test:integration": "vitest run -c test/vitest-integration.config.ts",
        "test:integration:coverage": "vitest run -c test/vitest-integration.config.ts --coverage",
        "test": "pnpm run test:unit && pnpm run test:integration",
        "test:watch": "vitest -c test/vitest.config.ts"
    },
    "dependencies": {
        "@hiero-ledger/sdk": "^2.86.2",
        "bignumber.js": "^11.1.5"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
