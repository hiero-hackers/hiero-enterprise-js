{
    "name": "hiero-enterprise-js",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.29.1",
    "description": "Enterprise-grade TypeScript library for Hiero networks",
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "test:unit": "pnpm -r run test:unit",
        "test:integration": "pnpm -r run test:integration",
        "test:watch": "pnpm -r run test:watch",
        "lint": "eslint . --fix",
        "format": "prettier --write .",
        "example": "pnpm --filter @hiero-hackers/examples examples",
        "conventions": "node scripts/check-conventions.mjs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@eslint/js": "^10.0.1",
        "@hiero-hackers/enterprise-core": "workspace:*",
        "@nestjs/testing": "^11.1.28",
        "@types/express": "^5.0.0",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-security": "^4.0.0",
        "globals": "^17.7.0",
        "prettier": "^3.9.5",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.64.0",
        "vitest": "^4.1.10",
        "yaml": "^2.9.0"
    }
}
