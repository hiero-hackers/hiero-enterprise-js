{
    "name": "hiero-enterprise-js",
    "version": "0.1.0",
    "private": true,
    "description": "Enterprise-grade TypeScript library for Hiero networks",
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "test:unit": "pnpm -r run test:unit",
        "test:integration": "pnpm -r run test:integration",
        "test:watch": "pnpm -r run test:watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.5.2",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "prettier": "^3.8.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1"
    },
    "engines": {
        "node": ">=20"
    }
}
