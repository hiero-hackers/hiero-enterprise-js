{
    "name": "hiero-enterprise-js",
    "version": "0.5.0",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "description": "Enterprise-grade TypeScript library for Hiero networks",
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "test:unit": "pnpm -r run test:unit",
        "test:integration": "pnpm -r run test:integration",
        "test:watch": "pnpm -r run test:watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "example": "pnpm --filter @hiero-hackers/examples examples"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@eslint/js": "^10.0.1",
        "@hiero-hackers/enterprise-core": "workspace:*",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-security": "^4.2.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5",
        "yaml": "^2.9.1"
    }
}
